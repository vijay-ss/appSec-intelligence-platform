# AppSec Intelligence Platform — Environment Variables
# Copy this file to .env and fill in real values.
# .env is git-ignored — never commit credentials.

# ── LLM Provider ─────────────────────────────────────────────────────────────
# Three providers supported. Uncomment one block.

# Option 1: Ollama (local, default — no API key needed, uses ~5GB RAM)
LLM_PROVIDER=ollama
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_BASE_URL=http://localhost:11434
EMBEDDING_PROVIDER=ollama

# Option 2: Groq (free remote inference — saves laptop RAM, no GPU needed)
# Sign up free at https://console.groq.com to get an API key.
# Groq has no embeddings API — keep EMBEDDING_PROVIDER=ollama (needs Ollama
# running for embeddings only) or switch to openai if you have a key.
# LLM_PROVIDER=groq
# GROQ_API_KEY=gsk_...
# GROQ_MODEL=llama-3.3-70b-versatile   # or: mixtral-8x7b-32768, gemma2-9b-it
# EMBEDDING_PROVIDER=ollama             # Ollama still needed for embeddings
# OLLAMA_EMBED_MODEL=nomic-embed-text
# OLLAMA_BASE_URL=http://localhost:11434

# Option 3: Anthropic Claude (paid, production quality)
# Embeddings use OpenAI — both keys required.
# LLM_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-sonnet-4-5-20251001
# EMBEDDING_PROVIDER=openai
# OPENAI_API_KEY=sk-...

# ── Object storage (MinIO) ───────────────────────────────────────────────────
MINIO_ENDPOINT=localhost:9000            # host:port — no http:// scheme
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false                       # set true in production with TLS

# ── Message bus ──────────────────────────────────────────────────────────────
KAFKA_BROKERS=localhost:9092

# ── Databases ────────────────────────────────────────────────────────────────
POSTGRES_URL=postgresql://appsec:appsec@localhost:5432/appsec
QDRANT_URL=http://localhost:6333
REDIS_ADDR=localhost:6379
REDIS_URL=redis://localhost:6379

# ── GitHub (required for Events API poller and file fetching in triage agent) ─
GITHUB_TOKEN=ghp_...   # free — Personal Access Token at github.com/settings/tokens

# ── NVD API key (free, increases rate limit from 5 to 50 req/30s) ────────────
NVD_API_KEY=           # register at https://nvd.nist.gov/developers/request-an-api-key

# ── Flink ────────────────────────────────────────────────────────────────────
FLINK_CHECKPOINT_DIR=s3://flink-checkpoints/appsec
FLINK_PARALLELISM=2

# ── Synthetic generator ───────────────────────────────────────────────────────
HUM_RATE=2.0
SEED_REGISTRY=true
